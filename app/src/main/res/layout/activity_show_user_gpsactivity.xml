<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".viewes.ShowUserGPSActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center"
            >

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="EmployeeCode"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                app:boxBackgroundColor="@color/white">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/employeeCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:inputType="textNoSuggestions"
                    android:maxLength="20"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Pick Date Here"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                app:boxBackgroundColor="@color/white">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/travelDate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:inputType="textNoSuggestions"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:maxLength="20"/>

            </com.google.android.material.textfield.TextInputLayout>
            <EditText

                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_frame_gps"
                android:drawableLeft="@drawable/ic_date_range_24"
                android:hint="Pick Date Here"
                android:focusable="false"
                android:visibility="gone"
                android:gravity="center"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pull_track_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="invisible"
                android:text="SHOW"
                android:layout_weight="1"
                android:layout_gravity="left"
                android:onClick="listeners"
                android:background="@drawable/edittext_frame_gps"
                android:backgroundTint="@color/colorPrimary"
                >
            </Button>

            <Button
                android:id="@+id/show_map_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_frame_gps"
                android:backgroundTint="@color/colorPrimary"
                android:onClick="listeners"
                android:layout_gravity="center"
                android:text="VIEW MAP"
                android:layout_weight="1"
                android:visibility="visible">

            </Button>

        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gps_track_details_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>


    </LinearLayout>


</androidx.core.widget.NestedScrollView>